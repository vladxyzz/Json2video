PORT=3000
HOST=127.0.0.1
# Set for a server deployment. Leave empty for local development.
# PUBLIC_BASE_URL=https://video.example.com
# API_KEY=replace-with-a-random-secret-of-at-least-24-characters
# DOWNLOAD_SIGNING_KEY=optional-independent-random-secret
# WEBHOOK_SIGNING_SECRET=optional-secret-for-HMAC-SHA256-callbacks
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# BFL_API_KEY=
# The Make alias flux-pro maps explicitly to FLUX 1.1 Pro, approved for this project.
# FFMPEG_PATH=/usr/bin/ffmpeg
# ESPEAK_PATH=/usr/bin/espeak-ng
# Subtitles are drawn with libass (ASS) by default. Set to png to use the older
# one-image-per-cue renderer instead.
# J2V_SUBTITLES=png
